# hopparch lock screen: black, one line of text, password field. Nothing else.
# The text is ~/.config/hopparch/lock-text. The repo ships a default line.
# Replace that file to change it. An empty file shows nothing.

general {
    hide_cursor = true
}

animations {
    enabled = false
}

background {
    monitor =
    color = @bg:rgba@
}

label {
    monitor =
    text = cmd[update:60000] cat ~/.config/hopparch/lock-text 2>/dev/null
    font_family = JetBrainsMono Nerd Font
    font_size = 26
    color = @text:rgba@
    position = 0, 70
    halign = center
    valign = center
}

input-field {
    monitor =
    size = 320, 48
    rounding = 0
    outline_thickness = 2
    outer_color = @text:rgba@
    inner_color = @bg:rgba@
    font_color = @text:rgba@
    check_color = @text:rgba@
    fail_color = @alert:rgba@
    fade_on_empty = false
    placeholder_text =
    fail_text = wrong
    dots_center = true
    position = 0, -20
    halign = center
    valign = center
}
