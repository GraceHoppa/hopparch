# hopparch notifications: 0xyc, flat
font=JetBrainsMono Nerd Font 11
background-color=@bg:hex=f2@
text-color=@text:hex@
border-color=@focus:hex@
border-size=2
border-radius=0
padding=10
default-timeout=5000

# Claude Code pop-ups stay until clicked
[app-name="Claude Code"]
default-timeout=0

# do-not-disturb (makoctl mode -a do-not-disturb): nothing shows, e.g. while recording
[mode=do-not-disturb]
invisible=1
