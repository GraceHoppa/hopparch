# hopparch fuzzel: launcher (SUPER+D) and the list behind every menu
[main]
font=JetBrainsMono Nerd Font:size=13
terminal=kitty -1
# no big picture of the selected app under short lists
image-size-ratio=0

[colors]
background=@bg:bare=f2@
text=@text:bare=ff@
match=@white:bare=ff@
selection=@dim:bare=ff@
selection-text=@text:bare=ff@
selection-match=@white:bare=ff@
border=@focus:bare=ff@

[border]
width=2
radius=0
