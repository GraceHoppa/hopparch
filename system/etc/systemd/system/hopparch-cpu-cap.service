[Unit]
Description=Hopparch: raise the AMD CPU cap when boost is allowed
After=power-profiles-daemon.service
ConditionPathExists=/sys/devices/system/cpu/amd_pstate/status
ConditionPathExistsGlob=/sys/class/power_supply/BAT*

[Service]
Type=oneshot
ExecStartPre=/usr/bin/sleep 2
ExecStart=/usr/local/lib/hopparch/cpu-cap.sh

[Install]
# graphical, not multi-user: power-profiles-daemon 0.30 starts after
# multi-user.target, so multi-user + After= it was an ordering loop and systemd
# skipped this unit at every boot
WantedBy=graphical.target
